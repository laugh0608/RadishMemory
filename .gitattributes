* text=auto eol=lf

*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Preserve reviewed upstream bytes; provenance hashes guard this exact vendor copy.
third_party/vendor/windows-native-keyring-store-1.1.0/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
