root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,cc,cpp,cs,h,hpp,java,kt,kts,py,ps1,psm1,psd1,swift}]
indent_size = 4

[*.{go,rs}]
indent_style = tab

[*.{json,jsonc,yaml,yml,toml,md,sh}]
indent_size = 2

[Makefile]
indent_style = tab
